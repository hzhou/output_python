subcode: _autoload
    $(if:PYTHON2)
        from Tkinter import *
    $(else)
        from tkinter import *

subcode: tkinter
    win_main = Tk()
    $call @main
    win_main.mainloop()

    subcode: add_canvas(w, h)
        C = Canvas(win_main, width=$(w), height=$(h))
        BLOCK
        C.pack()

    subcode: animate(delay)
        def animate():
            BLOCK
            win_main.after($(delay), animate)

        animate()

#---- examples -----
    C.config(background='#eeeeee')
